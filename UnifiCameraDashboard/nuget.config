<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds a local flat-folder feed for NotifyHub (github.com/lukislp/NotifyHub) - a separate repo
  not published to nuget.org. Its GitHub Releases attach real versioned nupkgs; this feed points
  at nuget-packages/, populated by downloading those release assets (see
  nuget-packages/README.md and the Dockerfile's curl step), the same gitignored-and-downloaded
  treatment already used for Tools/yolo/yolo11n.onnx. Lives inside this project folder (not the
  repo root) so it's included in the Docker build context, which is scoped to ./UnifiCameraDashboard.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-notifyhub" value="nuget-packages" />
  </packageSources>
</configuration>
