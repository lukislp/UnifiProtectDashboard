<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds a local flat-folder feed for NotifyHub (github.com/lukislp/NotifyHub) - a separate repo
  not published to nuget.org. The nupkg itself is COMMITTED in nuget-packages/ (see the README
  there): any consumer that only checks out the repo - Dependabot above all - has to be able to
  restore without running a download step first, otherwise restore fails and every NuGet update
  stops. Lives inside this project folder (not the repo root) so it's included in the Docker
  build context, which is scoped to ./UnifiCameraDashboard.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-notifyhub" value="nuget-packages" />
  </packageSources>
</configuration>
