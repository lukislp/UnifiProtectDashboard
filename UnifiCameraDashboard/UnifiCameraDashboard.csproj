<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NuGet lock file (packages.lock.json): restore resolves exactly the recorded package graph,
    and in CI (CI=true) as well as in the Docker build the restore fails instead of silently
    updating the lock when csproj and lock disagree (OpenSSF Scorecard Pinned-Dependencies).
    Declared per project, not in a Directory.Build.props, because the Docker build context is
    this folder only. Dependabot updates the lock together with the package versions.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="NotifyHub" Version="0.2.2" />
    <!-- Implicit SDK package pinned explicitly so the lock stays valid across SDK patches. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <!-- Pinned above the transitive default to fix CVE-2025-6965 (SQLite memory corruption, GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Copy i18n JSON files to output directory -->
  <ItemGroup>
    <None Include="i18n\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Copy FFmpeg to output on publish -->
  <ItemGroup>
    <Content Include="Tools\ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy the YOLO ONNX model to output on publish (same treatment as Tools/ffmpeg above) -->
  <ItemGroup>
    <Content Include="Tools\yolo\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude HLS directory from static web assets (transient streaming files) -->
  <ItemGroup>
    <Content Remove="wwwroot\hls\**" />
    <None Include="wwwroot\hls\**" />
  </ItemGroup>

</Project>
