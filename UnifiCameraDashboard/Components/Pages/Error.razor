@page "/Error"
@using System.Diagnostics
@inject I18nService I18n

<PageTitle>@I18n.Get("ErrorPageTitle")</PageTitle>

<h1 class="text-danger">@I18n.Get("ErrorHeading")</h1>
<h2 class="text-danger">@I18n.Get("ErrorSubheading")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@I18n.Get("ErrorRequestId")</strong> <code>@RequestId</code>
    </p>
}

<h3>@I18n.Get("ErrorDevModeHeading")</h3>
<p>@I18n.Get("ErrorDevModeDesc1")</p>
<p>@I18n.Get("ErrorDevModeDesc2")</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
