@page "/settings"
@rendermode InteractiveServer
@using UnifiCameraDashboard.Services
@inject ISettingsService SettingsService
@inject I18nService I18n
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@I18n.Get("SettingsTitle")</PageTitle>

<div class="settings-page">
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3>
                            <i class="bi bi-gear"></i>
                            @I18n.Get("SettingsTitle")
                        </h3>
                    </div>
                    <div class="card-body">
    
                        <!-- Unifi Protect Connection -->
                        <div class="settings-section mb-4">
                            <h5><i class="bi bi-server"></i> @I18n.Get("SettingsUnifiConnection")</h5>
                            <hr />
   
                            <div class="mb-3">
                                <label class="form-label">@I18n.Get("SettingsUnifiUrl")</label>
                                <input type="text" class="form-control" @bind="_protectUrl" placeholder="https://192.168.2.20" />
                                <small class="form-text text-muted">@I18n.Get("SettingsUnifiUrlHint")</small>
                            </div>
    
                            <div class="mb-3">
                                <label class="form-label">@I18n.Get("SettingsUsername")</label>
                                <input type="text" class="form-control" @bind="_username" placeholder="dashboard" />
                                <small class="form-text text-muted">@I18n.Get("SettingsUsernameHint")</small>
                            </div>
      
                            <div class="mb-3">
                                <label class="form-label">@I18n.Get("SettingsPassword")</label>
                                <input type="password" class="form-control" @bind="_password" />
                            </div>

                            <button class="btn btn-success" @onclick="SaveCredentials" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-save"></i>
                                @I18n.Get("SaveCredentials")
                            </button>
                        </div>

                        <!-- Performance Settings -->
                        <div class="settings-section mb-4">
                            <h5><i class="bi bi-speedometer"></i> @I18n.Get("SettingsPerformance")</h5>
                            <hr />

                            <div class="mb-3">
                                <label class="form-label">@I18n.Get("SettingsRefreshInterval")</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" @bind="_refreshInterval" min="1" max="60" />
                                    <span class="input-group-text">@I18n.Get("SettingsRefreshIntervalUnit")</span>
                                </div>
                                <small class="form-text text-muted">
                                    @I18n.Get("SettingsRefreshIntervalHint")
                                </small>
                            </div>

                            <div class="alert alert-info">
                                <h6><i class="bi bi-info-circle"></i> @I18n.Get("SettingsStreamComparison")</h6>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@I18n.Get("SettingsMode")</th>
                                            <th>@I18n.Get("SettingsFps")</th>
                                            <th>@I18n.Get("SettingsBandwidth")</th>
                                            <th>@I18n.Get("SettingsRecommendation")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>Snapshot (1s)</strong></td>
                                            <td>~1 FPS</td>
                                            <td>~60 KB/s</td>
                                            <td>@I18n.Get("SettingsEfficientSmooth")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Snapshot (5s)</strong></td>
                                            <td>~0.2 FPS</td>
                                            <td>~12 KB/s</td>
                                            <td>@I18n.Get("SettingsVeryEfficient")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>MJPEG Stream</strong></td>
                                            <td>~10 FPS</td>
                                            <td>~600 KB/s</td>
                                            <td>@I18n.Get("SettingsHigherLoad")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" @bind="_autoDiscovery" />
                                <label class="form-check-label">@I18n.Get("SettingsAutoDiscovery")</label>
                                <br />
                                <small class="form-text text-muted">@I18n.Get("SettingsAutoDiscoveryHint")</small>
                            </div>
                        </div>

                        <!-- Notifications -->
                        <div class="settings-section mb-4">
                            <h5><i class="bi bi-bell"></i> @I18n.Get("SettingsNotifications")</h5>
                            <hr />
                            <p class="text-muted">@I18n.Get("SettingsNotificationsHint")</p>

                            <div class="mb-3">
                                @if (_pushStatus == "enabled")
                                {
                                    <span class="badge bg-success mb-2"><i class="bi bi-check-circle"></i> @I18n.Get("SettingsNotificationsEnabled")</span>
                                    <div class="mt-2">
                                        <button class="btn btn-outline-danger" @onclick="DisablePush" disabled="@_isPushBusy">
                                            @I18n.Get("SettingsNotificationsDisable")
                                        </button>
                                        <button class="btn btn-outline-primary ms-2" @onclick="SendTestNotification" disabled="@_isPushBusy">
                                            @I18n.Get("SettingsNotificationsTest")
                                        </button>
                                    </div>
                                }
                                else if (_pushStatus == "unsupported")
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> @I18n.Get("SettingsNotificationsUnsupported")</span>
                                }
                                else
                                {
                                    <button class="btn btn-primary" @onclick="EnablePush" disabled="@_isPushBusy">
                                        @if (_isPushBusy)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bi bi-bell"></i>
                                        @I18n.Get("SettingsNotificationsEnable")
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_pushStatusMessage))
                            {
                                <div class="alert alert-@_pushStatusClass">@_pushStatusMessage</div>
                            }
                        </div>

                        <!-- Daily Digest -->
                        <div class="settings-section mb-4">
                            <h5><i class="bi bi-calendar-check"></i> @I18n.Get("SettingsDailyDigest")</h5>
                            <hr />

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" @bind="_dailyDigestEnabled" />
                                <label class="form-check-label">@I18n.Get("SettingsDailyDigestEnabled")</label>
                                <br />
                                <small class="form-text text-muted">@I18n.Get("SettingsDailyDigestHint")</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@I18n.Get("SettingsDailyDigestTime")</label>
                                <input type="time" class="form-control" style="max-width: 200px;" @bind="_dailyDigestTime" />
                            </div>

                            <button class="btn btn-success" @onclick="SaveDailyDigestSettings" disabled="@_isSaving">
                                <i class="bi bi-save"></i>
                                @I18n.Get("SettingsDailyDigestSave")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(_statusMessage))
                        {
                            <div class="alert alert-@_statusClass" role="alert">
                                @_statusMessage
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveAllSettings" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-save"></i>
                                @I18n.Get("SaveAllSettings")
                            </button>

                            <a href="/" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                @I18n.Get("BackToDashboard")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .settings-page {
        min-height: 100vh;
        background: var(--dashboard-bg, #0a0e27);
        padding: 2rem 0;
    }

    .card {
        background: var(--tile-bg, #1e2336);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-primary, #fff);
    }

    .card-header {
        background: rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .form-control {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--text-primary, #fff);
    }

        .form-control:focus {
            background: rgba(0, 0, 0, 0.4);
            border-color: var(--status-online, #10b981);
            color: var(--text-primary, #fff);
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.25);
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

    .settings-section h5 {
        color: var(--status-online, #10b981);
        margin-bottom: 1rem;
    }

    .table {
        color: var(--text-primary, #fff);
        font-size: 0.9rem;
    }
</style>

@code {
    private string _protectUrl = "";
    private string _username = "";
    private string _password = "";
    private int _refreshInterval = 5;
    private bool _autoDiscovery = true;
    private bool _isSaving = false;
    private string _statusMessage = "";
    private string _statusClass = "info";

    // "enabled" | "disabled" | "unsupported" - starts "disabled" until OnAfterRenderAsync can
    // actually ask the browser (webPush.getStatus needs a live JS runtime, unavailable during
    // prerendering).
    private string _pushStatus = "disabled";
    private bool _isPushBusy = false;
    private string _pushStatusMessage = "";
    private string _pushStatusClass = "info";

    private bool _dailyDigestEnabled;
    private TimeOnly _dailyDigestTime = new(20, 0);

    protected override async Task OnInitializedAsync()
    {
        // Load current settings
        _protectUrl = await SettingsService.GetUnifiProtectUrlAsync() ?? "https://192.168.2.20";
        _username = await SettingsService.GetUsernameAsync() ?? "";
        _password = await SettingsService.GetPasswordAsync() ?? "";
        _refreshInterval = await SettingsService.GetRefreshIntervalAsync();
        _autoDiscovery = await SettingsService.GetAutoDiscoveryEnabledAsync();
        _dailyDigestEnabled = await SettingsService.GetDailyDigestEnabledAsync();
        var storedTime = await SettingsService.GetDailyDigestTimeOfDayAsync();
        _dailyDigestTime = TimeOnly.TryParseExact(storedTime, "HH:mm", out var parsedTime) ? parsedTime : new TimeOnly(20, 0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pushStatus = await JS.InvokeAsync<string>("webPush.getStatus");
            StateHasChanged();
        }
    }

    private async Task SaveCredentials()
    {
        try
        {
            _isSaving = true;
            _statusMessage = "";
            StateHasChanged();

            if (string.IsNullOrEmpty(_protectUrl) || string.IsNullOrEmpty(_username) || string.IsNullOrEmpty(_password))
            {
                _statusMessage = I18n.Get("SettingsFillAllFields");
                _statusClass = "warning";
                return;
            }

            await SettingsService.SaveUnifiCredentialsAsync(_protectUrl, _username, _password);

            _statusMessage = I18n.Get("SettingsSavedCredentials");
            _statusClass = "success";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusClass = "danger";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveAllSettings()
    {
        try
        {
            _isSaving = true;
            _statusMessage = "";
            StateHasChanged();

            // Save credentials
            if (!string.IsNullOrEmpty(_protectUrl) && !string.IsNullOrEmpty(_username) && !string.IsNullOrEmpty(_password))
            {
                await SettingsService.SaveUnifiCredentialsAsync(_protectUrl, _username, _password);
            }

            // Save refresh interval
            await SettingsService.SetSettingAsync("RefreshIntervalSeconds", _refreshInterval.ToString());

            // Save auto-discovery
            await SettingsService.SetSettingAsync("AutoDiscoveryEnabled", _autoDiscovery.ToString());

            _statusMessage = I18n.Get("SettingsSavedAll");
            _statusClass = "success";

            // Navigate back to dashboard after 2 seconds
            await Task.Delay(2000);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusClass = "danger";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task EnablePush()
    {
        try
        {
            _isPushBusy = true;
            _pushStatusMessage = "";
            StateHasChanged();

            var result = await JS.InvokeAsync<PushJsResult>("webPush.enable");
            if (result.Success)
            {
                _pushStatus = "enabled";
                _pushStatusMessage = I18n.Get("SettingsNotificationsEnabledMsg");
                _pushStatusClass = "success";
            }
            else
            {
                _pushStatusMessage = result.Error ?? I18n.Get("SettingsNotificationsError");
                _pushStatusClass = "danger";
            }
        }
        catch (Exception ex)
        {
            _pushStatusMessage = $"Error: {ex.Message}";
            _pushStatusClass = "danger";
        }
        finally
        {
            _isPushBusy = false;
            StateHasChanged();
        }
    }

    private async Task DisablePush()
    {
        try
        {
            _isPushBusy = true;
            StateHasChanged();

            await JS.InvokeVoidAsync("webPush.disable");
            _pushStatus = "disabled";
            _pushStatusMessage = I18n.Get("SettingsNotificationsDisabledMsg");
            _pushStatusClass = "info";
        }
        catch (Exception ex)
        {
            _pushStatusMessage = $"Error: {ex.Message}";
            _pushStatusClass = "danger";
        }
        finally
        {
            _isPushBusy = false;
            StateHasChanged();
        }
    }

    private async Task SendTestNotification()
    {
        try
        {
            _isPushBusy = true;
            _pushStatusMessage = "";
            StateHasChanged();

            var result = await JS.InvokeAsync<PushTestJsResult>("webPush.test");
            if (result.Success)
            {
                _pushStatusMessage = I18n.Format("SettingsNotificationsTestMsg", result.Delivered, result.Total);
                _pushStatusClass = result.Delivered > 0 ? "success" : "warning";
            }
            else
            {
                _pushStatusMessage = result.Error ?? I18n.Get("SettingsNotificationsError");
                _pushStatusClass = "danger";
            }
        }
        catch (Exception ex)
        {
            _pushStatusMessage = $"Error: {ex.Message}";
            _pushStatusClass = "danger";
        }
        finally
        {
            _isPushBusy = false;
            StateHasChanged();
        }
    }

    private async Task SaveDailyDigestSettings()
    {
        try
        {
            _isSaving = true;
            _statusMessage = "";
            StateHasChanged();

            await SettingsService.SaveDailyDigestSettingsAsync(_dailyDigestEnabled, _dailyDigestTime.ToString("HH:mm"));

            _statusMessage = I18n.Get("SettingsDailyDigestSavedMsg");
            _statusClass = "success";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusClass = "danger";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private sealed class PushJsResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
    }

    private sealed class PushTestJsResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public int Delivered { get; set; }
        public int Total { get; set; }
    }
}
