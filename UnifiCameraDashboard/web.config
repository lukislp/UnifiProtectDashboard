<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Handler for ASP.NET Core -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- ASP.NET Core hosting configuration -->
      <aspNetCore processPath="dotnet"
                  arguments=".\UnifiCameraDashboard.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  forwardWindowsAuthToken="false">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Port is set by the IIS site binding -->
          <environmentVariable name="ASPNETCORE_URLS" value="http://*:5008" />
        </environmentVariables>
      </aspNetCore>

      <!-- Security headers -->
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="X-XSS-Protection" value="1; mode=block" />
        </customHeaders>
      </httpProtocol>

      <!-- MIME types for HLS streaming -->
      <staticContent>
        <remove fileExtension=".m3u8" />
        <mimeMap fileExtension=".m3u8" mimeType="application/vnd.apple.mpegurl" />
        <remove fileExtension=".ts" />
        <mimeMap fileExtension=".ts" mimeType="video/MP2T" />
      </staticContent>

      <!-- Request limits for large HLS segments -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" /> <!-- 100 MB -->
        </requestFiltering>
      </security>

      <!-- Compression -->
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />

      <!-- Error pages (optional) -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
