<?xml version="1.0" encoding="utf-8"?>
<!--
  Solution-wide counterpart to UnifiCameraDashboard/nuget.config. NuGet's config discovery walks
  UP from each individual project's own directory, never sideways into a sibling folder - so
  `dotnet restore UnifiCameraDashboard.sln` (run from the repo root, restoring both
  UnifiCameraDashboard.csproj AND the sibling UnifiCameraDashboard.Tests.csproj, which needs
  NotifyHub transitively via its ProjectReference) needs a config visible from ITS OWN directory
  too - UnifiCameraDashboard/nuget.config alone isn't enough. Different source key from the other
  file to avoid any ambiguity if NuGet ever merges both (project-local restore finds its own
  nuget.config first and stops there; this one is only reached from a sibling/ancestor lookup).
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-notifyhub-root" value="UnifiCameraDashboard/nuget-packages" />
  </packageSources>
</configuration>
